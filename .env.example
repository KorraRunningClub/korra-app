# Copie para .env.local (desenvolvimento) e preencha com os dados do Supabase:
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("publishable" sb_publishable_... ou a antiga "anon"). Nunca use a chave secreta aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
